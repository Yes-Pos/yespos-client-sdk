{
	"name": "@yespos/client",
	"version": "0.1.0",
	"description": "SDK resmi untuk YesPOS Client API: outlet, produk, metode pembayaran, dan order (QRIS, Virtual Account, EDC).",
	"keywords": [
		"yespos",
		"ipaymu",
		"pos",
		"payment",
		"qris",
		"virtual-account",
		"edc"
	],
	"license": "MIT",
	"author": "iPaymu",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Yes-Pos/yespos-client-sdk.git"
	},
	"homepage": "https://github.com/Yes-Pos/yespos-client-sdk#readme",
	"bugs": {
		"url": "https://github.com/Yes-Pos/yespos-client-sdk/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run typecheck && npm run test && npm run build"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"tsup": "^8.5.0",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	}
}
